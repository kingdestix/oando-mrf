-- Name: v_request_analytics _RETURN; Type: RULE; Schema: public; Owner: postgres
--

CREATE OR REPLACE VIEW public.v_request_analytics AS
 SELECT r.id,
    r.mrf_number,
    r.request_date,
    r.year,
    (((r.first_name)::text || ' '::text) || (r.last_name)::text) AS requester_name,
    r.asset,
    r.discipline,
    r.criticality,
    r.status,
    r.vendor_name,
    r.approved_by,
    count(l.id) AS line_items_count,
    sum(l.quantity) AS total_quantity,
    sum(l.total_price_usd) AS total_value_usd,
    sum(l.total_price_ngn) AS total_value_ngn,
    r.created_at
   FROM (public.material_requests r
     LEFT JOIN public.material_request_lines l ON ((r.id = l.request_id)))
  GROUP BY r.id;


